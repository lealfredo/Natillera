<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Natillera.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Natillera.Views"
    Title="Natillera"
    FlyoutBehavior="Flyout"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}"
    Shell.TabBarTitleColor="{StaticResource Primary}">

    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}"/>
            <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}"/>
        </Style>
    </Shell.Resources>

    <Shell.FlyoutHeader>
        <Grid Padding="24"
              BackgroundColor="{StaticResource Primary}"
              HeightRequest="200">

            <VerticalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="8">

                <Image
                    Source="logo.png"
                    HeightRequest="160"
                    WidthRequest="160"
                    Aspect="AspectFit" />

            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Inicio" Icon="home">
        <ShellContent
            Title="Dashboard"
            Icon="home"
            ContentTemplate="{DataTemplate views:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Personas" Icon="winner">
        <ShellContent ContentTemplate="{DataTemplate views:ParticipantsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Aportes" Icon="ticket">
        <ShellContent ContentTemplate="{DataTemplate views:ContributionsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Préstamos" Icon="history">
        <ShellContent ContentTemplate="{DataTemplate views:LoansPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Liquidación" Icon="settings">
        <Tab Title="Liquidación" Icon="settings">
            <ShellContent
                Title="Liquidación"
                Icon="settings"
                ContentTemplate="{DataTemplate views:SettlementPage}" />

            <ShellContent
                Title="Resultados"
                Icon="settings"
                ContentTemplate="{DataTemplate views:SettlementResultPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Rifa" Icon="ticket">
        <Tab Title="Rifas" Icon="ticket">
            <ShellContent
                Title="Rifas"
                Icon="ticket"
                ContentTemplate="{DataTemplate views:RafflesPage}" />

            <ShellContent
                Title="Histórico"
                Icon="history"
                ContentTemplate="{DataTemplate views:RaffleHistoryPage}" />
        </Tab>
    </FlyoutItem>

    <FlyoutItem Title="Configuración" Icon="settings">
        <ShellContent
            Title="Ajustes"
            Icon="settings"
            ContentTemplate="{DataTemplate views:BackupPage}" />
    </FlyoutItem>

</Shell>
