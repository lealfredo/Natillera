<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Natillera.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Natillera.Views"
    Title="Rifas"
    FlyoutBehavior="Flyout"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}"
    Shell.TabBarTitleColor="{StaticResource Primary}">

    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}"/>
            <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}"/>
        </Style>
    </Shell.Resources>

    <Shell.FlyoutHeader>
        <Grid Padding="24"
              BackgroundColor="{StaticResource Primary}"
              HeightRequest="200">

            <VerticalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="8">

                <Image
                    Source="logo.png"
                    HeightRequest="160"
                    WidthRequest="160"
                    Aspect="AspectFit" />

            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <!-- ========================= -->
    <!-- SECCIÓN PRINCIPAL (TABS) -->
    <!-- ========================= -->
    <FlyoutItem
        Title="Inicio"
        Icon="home">

        <Tab
            Title="Rifas"
            Icon="ticket">

            <ShellContent
                Title="Rifas"
                Icon="ticket"
                ContentTemplate="{DataTemplate views:RafflesPage}" />

            <ShellContent
                Title="Histórico"
                Icon="history"
                ContentTemplate="{DataTemplate views:RaffleHistoryPage}" />

        </Tab>
    </FlyoutItem>

    <!-- ========================= -->
    <!-- CONFIGURACIÓN -->
    <!-- ========================= -->
    <FlyoutItem
        Title="Configuración"
        Icon="settings">

        <ShellContent
            Title="Ajustes"
            Icon="settings"
            ContentTemplate="{DataTemplate views:BackupPage}" />
    </FlyoutItem>

</Shell>
