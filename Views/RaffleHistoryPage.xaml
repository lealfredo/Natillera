<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.RaffleHistoryPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Historial"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Rifas cerradas y números ganadores"
                   Style="{StaticResource SectionSubtitle}" />

            <CollectionView
                x:Name="RafflesView"
                ItemsSource="{Binding Raffles}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding DrawDate, StringFormat='Sorteo: {0:dd/MM/yyyy}'}"
                                       Style="{StaticResource BodyLabel}"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding LotteryName}"
                                       Style="{StaticResource Caption}" />
                                <Label Text="{Binding WinningNumber, StringFormat='Ganador: {0}'}"
                                       Style="{StaticResource SuccessText}"
                                       FontSize="16" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Text="Ver detalles"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BindingContext.OpenRaffleCommand, Source={x:Reference RafflesView}}"
                                            CommandParameter="{Binding .}" />
                                    <Button Grid.Column="1"
                                            Text="Editar"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding BindingContext.EditRaffleCommand, Source={x:Reference RafflesView}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout IsVisible="{Binding NoExist}">
                <Label Text="No hay historial"
                       Style="{StaticResource EmptyStateLabel}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
