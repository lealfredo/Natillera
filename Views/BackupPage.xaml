<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.BackupPage"
             Title="Configuración y respaldo">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Ajustes"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="WhatsApp y respaldo de datos"
                   Style="{StaticResource SectionSubtitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Configuración de WhatsApp"
                           Style="{StaticResource FieldLabel}"
                           FontSize="16" />

                    <Label Text="Número de WhatsApp" Style="{StaticResource Caption}" />
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="Ej: 3001234567"
                        Keyboard="Telephone"
                        Text="{Binding Setting.WhatsAppNumber}" />

                    <Label Text="Nombre de contacto" Style="{StaticResource Caption}" />
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="Ej: Deicy"
                        Text="{Binding Setting.ContactName}" />

                    <Button
                        Text="Guardar configuración"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Respaldo de información"
                           Style="{StaticResource FieldLabel}"
                           FontSize="16" />

                    <Label Text="Exporta o importa todos los datos de la app"
                           Style="{StaticResource Caption}" />

                    <Button
                        Text="Exportar datos"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExportCommand}" />

                    <Button
                        Text="Importar datos"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
