<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.ContributionReceiptPage"
             Title="Recibo">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Recibo de aporte"
                           Style="{StaticResource SectionTitle}"
                           HorizontalOptions="Center" />

                    <Label Text="{Binding ParticipantName}"
                           Style="{StaticResource BodyLabel}"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label Text="{Binding Date, StringFormat='Fecha: {0:dd/MM/yyyy}'}"
                           Style="{StaticResource Caption}" />

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderSubtle}" />

                    <CollectionView ItemsSource="{Binding Details}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                                    <Label Text="{Binding MonthName}" Style="{StaticResource BodyLabel}" />
                                    <Label Text="{Binding Amount, StringFormat='$ {0:N0}'}"
                                           Grid.Column="1"
                                           Style="{StaticResource BodyLabel}"
                                           FontAttributes="Bold" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderSubtle}" />

                    <Label Text="{Binding Total, StringFormat='TOTAL: $ {0:N0}'}"
                           Style="{StaticResource SuccessText}"
                           FontSize="18"
                           HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
