<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.RaffleWinnersPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <VerticalStackLayout Spacing="16" IsVisible="{Binding Exist}">

                <Label Text="Resultado del sorteo"
                       Style="{StaticResource SectionTitle}" />
                <Label Text="Confirma el número ganador y revisa el resumen"
                       Style="{StaticResource SectionSubtitle}" />

                <Border Style="{StaticResource Card}" IsVisible="{Binding IsOpen}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Número ganador" Style="{StaticResource FieldLabel}" FontSize="16" />
                        <Entry Style="{StaticResource FormEntry}"
                               Placeholder="Número ganador (0000)"
                               Keyboard="Numeric"
                               MaxLength="4"
                               Text="{Binding WinningNumber}" />
                        <Button
                            Style="{StaticResource PrimaryButton}"
                            Text="Confirmar número ganador"
                            Command="{Binding SaveWinningNumberCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="Información de la rifa"
                               Style="{StaticResource FieldLabel}"
                               FontSize="16" />

                        <Label Text="Semana" Style="{StaticResource Caption}" />
                        <Label Text="{Binding CurrentRaffle.WeekCode}" Style="{StaticResource BodyLabel}" />

                        <Label Text="Fecha sorteo" Style="{StaticResource Caption}" />
                        <Label Text="{Binding CurrentRaffle.DrawDate, StringFormat='{0:dd/MM/yyyy}'}"
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="Lotería" Style="{StaticResource Caption}" />
                        <Label Text="{Binding CurrentRaffle.LotteryName}" Style="{StaticResource BodyLabel}" />

                        <Label Text="Qué se rifa" Style="{StaticResource Caption}" />
                        <Label Text="{Binding CurrentRaffle.PrizeDescription}" Style="{StaticResource BodyLabel}" />

                        <Label Text="Precio de la boleta" Style="{StaticResource Caption}" />
                        <Label Text="{Binding CurrentRaffle.BetPrize, StringFormat='$ {0:N0}'}"
                               Style="{StaticResource BodyLabel}"
                               FontAttributes="Bold" />

                        <Label Text="Premios" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <Label Text="{Binding CurrentRaffle.FirstTwoPrize, StringFormat='2 primeras: $ {0:N0}'}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding CurrentRaffle.MiddleTwoPrize, StringFormat='2 del medio: $ {0:N0}'}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding CurrentRaffle.LastTwoPrize, StringFormat='2 últimas: $ {0:N0}'}"
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="Número ganador"
                               Style="{StaticResource Caption}"
                               Margin="0,8,0,0" />
                        <Label Text="{Binding CurrentRaffle.WinningNumber}"
                               Style="{StaticResource MetricValue}"
                               TextColor="{StaticResource Success}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}"
                        BackgroundColor="{StaticResource MetricRifas}"
                        IsVisible="{Binding IsClose}">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="Resumen económico"
                               Style="{StaticResource FieldLabel}"
                               FontSize="16" />

                        <Label Text="{Binding TotalSold, StringFormat='Números vendidos: {0}'}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding TotalCollected, StringFormat='Recaudado: $ {0:N0}'}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding TotalPrizes, StringFormat='Premios: $ {0:N0}'}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="{Binding NetProfit, StringFormat='Ganancia: $ {0:N0}'}"
                               Style="{StaticResource MetricValue}"
                               FontSize="20"
                               TextColor="{StaticResource Success}" />

                        <Button
                            Style="{StaticResource PrimaryButton}"
                            Text="Enviar resumen por WhatsApp"
                            Margin="0,8,0,0"
                            Command="{Binding SendSummaryCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Ganadores"
                       Style="{StaticResource SectionTitle}"
                       FontSize="18"
                       IsVisible="{Binding IsClose}" />

                <CollectionView ItemsSource="{Binding Winners}"
                                IsVisible="{Binding Exist}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}">
                                <VerticalStackLayout Spacing="6">

                                    <Label Text="{Binding ParticipantName}"
                                           Style="{StaticResource BodyLabel}"
                                           FontAttributes="Bold"
                                           FontSize="16" />

                                    <Label Text="{Binding Phone}"
                                           Style="{StaticResource Caption}" />

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Text="Número:" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Number}"
                                               Style="{StaticResource BodyLabel}"
                                               FontAttributes="Bold" />
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Text="Acierto:" Style="{StaticResource Caption}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding BetType}"
                                               Style="{StaticResource SuccessText}" />
                                    </Grid>

                                    <Label Text="{Binding PrizeAmount, StringFormat='Premio: $ {0:N0}'}"
                                           Style="{StaticResource SuccessText}"
                                           FontSize="15" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button
                    IsVisible="{Binding Winners.Count}"
                    Style="{StaticResource SecondaryButton}"
                    Text="Enviar ganadores por WhatsApp"
                    Command="{Binding BuildRaffleResultMessageCommand}" />

            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding NoExist}">
                <Label Text="No hay rifa creada"
                       Style="{StaticResource EmptyStateLabel}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
