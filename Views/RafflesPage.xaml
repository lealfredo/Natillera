<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.RafflesPage"
             Title="{Binding Title}">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PageRoot}">

                <Label Text="Rifas abiertas"
                       Style="{StaticResource SectionTitle}" />
                <Label Text="Toca una rifa para ver opciones"
                       Style="{StaticResource SectionSubtitle}" />

                <Button
                    Text="{Binding ButtonText}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding GoToCreateRaffleCommand}" />

                <CollectionView
                    x:Name="RafflesView"
                    ItemsSource="{Binding Raffles}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.ShowOptionsCommand, Source={x:Reference RafflesView}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding DrawDate, StringFormat='Sorteo: {0:dd/MM/yyyy}'}"
                                           Style="{StaticResource BodyLabel}"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding LotteryName}"
                                           Style="{StaticResource Caption}" />
                                    <Label Text="{Binding IsPersonal, Converter={StaticResource BoolToTextConverter}}"
                                           Style="{StaticResource Caption}"
                                           TextColor="{StaticResource Primary}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout IsVisible="{Binding NoExist}">
                    <Label Text="No hay rifas abiertas"
                           Style="{StaticResource EmptyStateLabel}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
