<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.SettlementPage"
             Title="Liquidación">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Cierre de natillera"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Calcula y cierra el año actual"
                   Style="{StaticResource SectionSubtitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Esta acción liquida aportes, intereses y utilidades del período."
                           Style="{StaticResource BodyLabel}" />
                    <Label Text="Revisa los resultados en la pestaña Resultados después de cerrar."
                           Style="{StaticResource Caption}" />

                    <Button Text="Cerrar año"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CloseYearCommand}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
