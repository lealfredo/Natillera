<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Natillera.ViewModels"
             x:Class="Natillera.Views.CreateRafflePage"
             x:DataType="viewModels:CreateRaffleViewModel"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Nueva rifa"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Completa los datos del sorteo"
                   Style="{StaticResource SectionSubtitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Datos generales" Style="{StaticResource FieldLabel}" FontSize="16" />

                    <Label Text="Nombre de la lotería" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Nombre de la lotería"
                           Text="{Binding RaffleWeek.LotteryName}" />

                    <Label Text="Código de la semana" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Código de la semana"
                           Text="{Binding WeekCode}"
                           IsEnabled="False" />

                    <Label Text="Qué se está rifando" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Ej: $500.000 en efectivo"
                           Text="{Binding RaffleWeek.PrizeDescription}" />

                    <Label Text="Fecha del sorteo" Style="{StaticResource Caption}" />
                    <DatePicker
                        Date="{Binding DrawDate}"
                        MinimumDate="{x:Static sys:DateTime.Today}" />

                    <Label Text="Precio de la boleta" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Precio de la boleta"
                           Keyboard="Numeric"
                           Text="{Binding RaffleWeek.BetPrize}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Premios por acierto" Style="{StaticResource FieldLabel}" FontSize="16" />

                    <Label Text="2 primeras cifras" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Premio 2 primeras cifras"
                           Keyboard="Numeric"
                           Text="{Binding RaffleWeek.FirstTwoPrize}" />

                    <Label Text="2 cifras del medio" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Premio 2 cifras del medio"
                           Keyboard="Numeric"
                           Text="{Binding RaffleWeek.MiddleTwoPrize}" />

                    <Label Text="2 últimas cifras" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Premio 2 últimas cifras"
                           Keyboard="Numeric"
                           Text="{Binding RaffleWeek.LastTwoPrize}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Guardar"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateRaffleCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
