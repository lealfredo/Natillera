<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.LoansPage"
             x:Name="Page"
            Title="Préstamos">
    <ScrollView>

    <VerticalStackLayout Padding="15" Spacing="10">

        <Picker Title="Participante (opcional)"
                ItemsSource="{Binding Participants}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedParticipant}" />

        <Entry Placeholder="Nombre (si es externo)"
               Text="{Binding BorrowerName}" />
        
        <DatePicker
            Date="{Binding StartDate}" />

        <Entry Placeholder="Monto"
               Keyboard="Numeric"
               Text="{Binding Amount}" />

        <Entry Placeholder="Interés % (ej: 5 = 5%)"
               Keyboard="Numeric"
               Text="{Binding InterestRate}" />

        <Button Text="Crear préstamo"
                Command="{Binding AddLoanCommand}" />

        <CollectionView ItemsSource="{Binding Loans}">
            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <SwipeView>

                        <!-- ACCIÓN -->
                        <SwipeView.RightItems>
                            <SwipeItems>
                                    <SwipeItem Text="Abonar"
                                               BackgroundColor="Green"
                                               Command="{Binding BindingContext.OpenPaymentCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}"/>
                                </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- CARD -->
                        <Frame Margin="8"
                       Padding="12"
                       CornerRadius="12"
                       HasShadow="True"
                       BackgroundColor="White"
                       BorderColor="#E0E0E0">

                            <VerticalStackLayout Spacing="6">

                                <!-- NOMBRE -->
                                <Label Text="{Binding Name}"
                               FontAttributes="Bold"
                               FontSize="16"/>

                                <Label Text="{Binding StartDate, StringFormat='{0:dd MMMM yyyy}'}"
                               FontSize="14"/>

                                <!-- PRÉSTAMO -->
                                <Label Text="{Binding Amount, StringFormat='Préstamo: $ {0:N0}'}"
                               FontSize="13"/>

                                <!-- INTERÉS MENSUAL -->
                                <Label Text="{Binding MonthlyInterest, StringFormat='Interés mensual: $ {0:N0}'}"
                               FontSize="13"
                               TextColor="#FF9800"/>

                                <!-- INTERÉS -->
                                <Label Text="{Binding InterestPaid, StringFormat='Interés pagado: $ {0:N0}'}"
                               FontSize="12"
                               TextColor="Gray"/>

                                <Label Text="{Binding PendingInterest, StringFormat='Interés pendiente: $ {0:N0}'}"
                               FontSize="12"
                               TextColor="Red"/>

                                <!-- CAPITAL -->
                                <Label Text="{Binding PrincipalPaid, StringFormat='Capital pagado: $ {0:N0}'}"
                               FontSize="12"
                               TextColor="Gray"/>

                                <Label Text="{Binding PendingPrincipal, StringFormat='Capital pendiente: $ {0:N0}'}"
                               FontSize="12"
                               TextColor="Red"/>

                                <!--  BALANCE TOTAL -->
                                <Label Text="{Binding Balance, StringFormat='Total pendiente: $ {0:N0}'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#2E7D32"/>

                            </VerticalStackLayout>

                        </Frame>

                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>