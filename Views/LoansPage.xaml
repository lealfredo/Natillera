<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.LoansPage"
             x:Name="Page"
             Title="Préstamos">

    <ScrollView>
        <Grid>
            <VerticalStackLayout Style="{StaticResource PageRoot}">

                <Label Text="Préstamos"
                       Style="{StaticResource SectionTitle}" />
                <Label Text="Crea y da seguimiento a créditos"
                       Style="{StaticResource SectionSubtitle}" />

                <SearchBar Placeholder="Buscar participante..."
                           Style="{StaticResource SearchField}"
                           Text="{Binding SearchText}" />

                <Border Style="{StaticResource Card}" Padding="0">
                    <CollectionView ItemsSource="{Binding FilteredParticipants}"
                                    SelectionMode="Single"
                                    SelectionChanged="CollectionView_SelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding BindingContext.LoadCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding Name}"
                                           Style="{StaticResource BodyLabel}"
                                           FontAttributes="Bold"
                                           FontSize="15" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Label Text="{Binding SelectedParticipant.Name, StringFormat='Seleccionado: {0}'}"
                       Style="{StaticResource BodyLabel}"
                       TextColor="{StaticResource Primary}"
                       FontAttributes="Italic"
                       IsVisible="{Binding SelectedParticipant, Converter={StaticResource NullToBoolConverter}}" />

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Nuevo préstamo" Style="{StaticResource FieldLabel}" FontSize="16" />

                        <Label Text="Nombre (si es externo)" Style="{StaticResource Caption}" />
                        <Entry Style="{StaticResource FormEntry}"
                               Placeholder="Nombre (si es externo)"
                               Text="{Binding BorrowerName}" />

                        <Label Text="Fecha" Style="{StaticResource Caption}" />
                        <DatePicker Date="{Binding StartDate}" />

                        <Label Text="Monto" Style="{StaticResource Caption}" />
                        <Entry Style="{StaticResource FormEntry}"
                               Placeholder="Monto"
                               Keyboard="Numeric"
                               Text="{Binding Amount}" />

                        <Label Text="Interés %" Style="{StaticResource Caption}" />
                        <Entry Style="{StaticResource FormEntry}"
                               Placeholder="Interés % (ej: 5 = 5%)"
                               Keyboard="Numeric"
                               Text="{Binding InterestRate}" />

                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Préstamo personal"
                                   Style="{StaticResource BodyLabel}"
                                   VerticalOptions="Center" />
                            <Switch IsToggled="{Binding IsPersonal}" />
                        </HorizontalStackLayout>

                        <Button Text="Crear préstamo"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddLoanCommand}" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="10" IsVisible="{Binding HasLoaded}">
                    <Label Text="Mostrar pagados"
                           Style="{StaticResource BodyLabel}"
                           VerticalOptions="Center" />
                    <Switch IsToggled="{Binding ShowPaid}" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasLoaded}">

                    <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricRifas}" Stroke="Transparent">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Natillera" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding TotalNatilleraLoansCount, StringFormat='Préstamos: {0}'}"
                                   Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="Prestado" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalNatilleraLoaned, StringFormat='$ {0:N0}'}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Info}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Pagado" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalNatilleraPaid, StringFormat='$ {0:N0}'}"
                                           Style="{StaticResource SuccessText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="Pendiente" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalNatilleraBalance, StringFormat='$ {0:N0}'}"
                                           Style="{StaticResource DangerText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricPrestamos}" Stroke="Transparent">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Personales" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding TotalPersonalLoansCount, StringFormat='Préstamos: {0}'}"
                                   Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="Prestado" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalPersonalLoaned, StringFormat='$ {0:N0}'}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Info}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Pagado" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalPersonalPaid, StringFormat='$ {0:N0}'}"
                                           Style="{StaticResource SuccessText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="Pendiente" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalPersonalBalance, StringFormat='$ {0:N0}'}"
                                           Style="{StaticResource DangerText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricAportes}" Stroke="Transparent">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Total" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding TotalLoansCount, StringFormat='Préstamos: {0}'}"
                                   Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="Prestado" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalLoaned, StringFormat='$ {0:N0}'}"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Info}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Pagado" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalPaid, StringFormat='$ {0:N0}'}"
                                           Style="{StaticResource SuccessText}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2">
                                    <Label Text="Pendiente" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding TotalBalance, StringFormat='$ {0:N0}'}"
                                           Style="{StaticResource DangerText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Seleccione un participante para cargar sus préstamos"
                       Style="{StaticResource EmptyStateLabel}"
                       IsVisible="{Binding HasLoaded, Converter={StaticResource InverseBoolConverter}}" />

                <CollectionView ItemsSource="{Binding Loans}"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItem Text="Pagar"
                                                   BackgroundColor="{StaticResource Success}"
                                                   Command="{Binding BindingContext.OpenPaymentCommand, Source={x:Reference Page}}"
                                                   CommandParameter="{Binding .}" />
                                        <SwipeItem Text="Eliminar"
                                                   BackgroundColor="{StaticResource Danger}"
                                                   Command="{Binding BindingContext.DeleteLoanCommand, Source={x:Reference Page}}"
                                                   CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Border Style="{StaticResource ListRow}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border"
                                                     Binding="{Binding IsPaid}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0.6" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceMuted}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto"
                                          RowSpacing="6">

                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                            <Border Padding="6,4"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    BackgroundColor="#C8E6C9"
                                                    IsVisible="{Binding IsPaid}">
                                                <Label Text="PAGADO"
                                                       FontSize="10"
                                                       TextColor="{StaticResource Success}"
                                                       FontAttributes="Bold" />
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Text="PERSONAL"
                                                   FontSize="10"
                                                   TextColor="{StaticResource Warning}"
                                                   VerticalOptions="Center"
                                                   FontAttributes="Bold"
                                                   IsVisible="{Binding IsPersonal}" />
                                        </Grid>

                                        <Label Grid.Row="1"
                                               Text="{Binding Name}"
                                               Style="{StaticResource BodyLabel}"
                                               FontAttributes="Bold"
                                               FontSize="16" />

                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding StartDate, StringFormat='{0:dd/MM/yyyy}'}"
                                               Style="{StaticResource Caption}"
                                               HorizontalOptions="End" />

                                        <Label Grid.Row="2"
                                               Text="{Binding Amount, StringFormat='Préstamo: $ {0:N0}'}"
                                               Style="{StaticResource BodyLabel}" />

                                        <Label Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding MonthlyInterest, StringFormat='$ {0:N0}/mes'}"
                                               FontSize="13"
                                               TextColor="{StaticResource Warning}"
                                               HorizontalOptions="End" />

                                        <Label Grid.Row="3"
                                               Text="{Binding InterestPaid, StringFormat='Int. pagado: $ {0:N0}'}"
                                               Style="{StaticResource Caption}" />

                                        <Label Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding PendingInterest, StringFormat='Pendiente: $ {0:N0}'}"
                                               Style="{StaticResource Caption}"
                                               HorizontalOptions="End">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding PendingInterest}" Value="0">
                                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding PendingInterest}" Value="0.0">
                                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <Label Grid.Row="4"
                                               Text="{Binding PrincipalPaid, StringFormat='Capital pagado: $ {0:N0}'}"
                                               Style="{StaticResource Caption}" />

                                        <Label Grid.Row="4"
                                               Grid.Column="1"
                                               Text="{Binding PendingPrincipal, StringFormat='Pendiente: $ {0:N0}'}"
                                               Style="{StaticResource DangerText}"
                                               FontSize="12"
                                               HorizontalOptions="End" />

                                        <BoxView Grid.Row="5"
                                                 Grid.ColumnSpan="2"
                                                 HeightRequest="1"
                                                 BackgroundColor="{StaticResource BorderSubtle}"
                                                 Margin="0,4" />

                                        <Label Grid.Row="6"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Balance, StringFormat='Total pendiente: $ {0:N0}'}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalOptions="End"
                                               TextColor="{StaticResource TextPrimary}" />
                                    </Grid>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

            <Grid BackgroundColor="#80000000"
                  IsVisible="{Binding IsLoading}">
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="12">
                    <ActivityIndicator IsRunning="True" Color="White" />
                    <Label Text="Cargando préstamos..."
                           TextColor="White"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
