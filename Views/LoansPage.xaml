<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.LoansPage"
             x:Name="Page"
            Title="Préstamos">
    <ScrollView>
        <Grid>
            <VerticalStackLayout Padding="15" Spacing="10">

            <!-- Buscador -->
            <SearchBar Placeholder="Buscar participante..."
               Text="{Binding SearchText}"
               CancelButtonColor="#1976D2"
               BackgroundColor="#ECEFF1"
               TextColor="#212121"
               PlaceholderColor="#757575"
               HeightRequest="40"
               Margin="0,0,0,5"
               />

            <!-- Lista filtrada estilo dropdown -->
            <Frame CornerRadius="12"
           Padding="0"
           HasShadow="True"
           BackgroundColor="White"
           BorderColor="#B0BEC5">

                <CollectionView ItemsSource="{Binding FilteredParticipants}"
                SelectionMode="Single"
                SelectionChanged="CollectionView_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <!-- Swipe actions -->
                                </SwipeView.RightItems>

                                <Grid Padding="10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectParticipantCommand, Source={x:Reference Page}}"
                                  CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Frame>

            <!-- Mostramos participante seleccionado -->
            <Label Text="{Binding SelectedParticipant.Name, StringFormat='Seleccionado: {0}'}"
           FontSize="14"
           FontAttributes="Italic"
           TextColor="#1976D2"
           IsVisible="{Binding SelectedParticipant, Converter={StaticResource NullToBoolConverter}}" />

            <!--<Picker Title="Participante (opcional)"
                ItemsSource="{Binding Participants}"
                ItemDisplayBinding="{Binding Name}"
                SelectedItem="{Binding SelectedParticipant}" />-->

            <VerticalStackLayout Spacing="10">
                <Entry Placeholder="Nombre (si es externo)"
                       Text="{Binding BorrowerName}" />
        
                <DatePicker
                    Date="{Binding StartDate}" />

                <Entry Placeholder="Monto"
                       Keyboard="Numeric"
                       Text="{Binding Amount}" />

                <Entry Placeholder="Interés % (ej: 5 = 5%)"
                       Keyboard="Numeric"
                       Text="{Binding InterestRate}" />
            
                    <HorizontalStackLayout>
                        <Label Text="Préstamo personal"/>
                        <Switch IsToggled="{Binding IsPersonal}" />
                    </HorizontalStackLayout>

                    <Button Text="Crear préstamo"
                        Command="{Binding AddLoanCommand}" />

            </VerticalStackLayout>


            <HorizontalStackLayout Spacing="10">

                <DatePicker Date="{Binding FromDate}" />
                <DatePicker Date="{Binding ToDate}" />

                <Button Text="Filtrar"
            Command="{Binding LoadCommand}" />

            </HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="Mostrar pagados"/>
                <Switch IsToggled="{Binding ShowPaid}" />
            </HorizontalStackLayout>

            <Label Text="Seleccione un rango y presione Filtrar"
       IsVisible="{Binding HasLoaded, Converter={StaticResource InverseBoolConverter}}" />

            <CollectionView ItemsSource="{Binding Loans}"
                            IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <SwipeView>

                            <!-- ACCIONES -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">

                                    <!-- PAGAR -->
                                    <SwipeItem BackgroundColor="#2E7D32"
                           Command="{Binding BindingContext.OpenPaymentCommand, Source={x:Reference Page}}"
                           CommandParameter="{Binding .}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource Glyph="💰" Color="White"/>
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>

                                    <!-- ELIMINAR -->
                                    <SwipeItem BackgroundColor="#C62828"
                           Command="{Binding BindingContext.DeleteLoanCommand, Source={x:Reference Page}}"
                           CommandParameter="{Binding .}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource Glyph="🗑️" Color="White"/>
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>

                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- CARD -->
                            <Frame Margin="8"
               Padding="12"
               CornerRadius="14"
               HasShadow="True"
               BackgroundColor="White"
               BorderColor="#E0E0E0">

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,Auto"
                  RowSpacing="6">

                                    <!-- BADGE PAGADO -->
                                    <Frame Grid.ColumnSpan="2"
                       Padding="4"
                       CornerRadius="8"
                       BackgroundColor="#C8E6C9"
                       HorizontalOptions="Start"
                       IsVisible="{Binding IsPaid}">

                                        <Label Text="✔ PAGADO"
                           FontSize="10"
                           TextColor="#2E7D32"/>
                                    </Frame>

                                    <Label Text="PERSONAL"
       TextColor="Orange"
       IsVisible="{Binding IsPersonal}" />

                                    <!-- NOMBRE -->
                                    <Label Grid.Row="1"
                       Text="{Binding Name}"
                       FontAttributes="Bold"
                       FontSize="16"/>

                                    <!-- FECHA -->
                                    <Label Grid.Row="1"
                       Grid.Column="1"
                       Text="{Binding StartDate, StringFormat='{0:dd/MM/yyyy}'}"
                       FontSize="12"
                       HorizontalOptions="End"
                       TextColor="Gray"/>

                                    <!-- MONTO -->
                                    <Label Grid.Row="2"
                       Text="{Binding Amount, StringFormat='Préstamo: $ {0:N0}'}"
                       FontSize="13"/>

                                    <!-- INTERÉS -->
                                    <Label Grid.Row="2"
                       Grid.Column="1"
                       Text="{Binding MonthlyInterest, StringFormat='$ {0:N0}/mes'}"
                       FontSize="13"
                       TextColor="#FB8C00"
                       HorizontalOptions="End"/>

                                    <!-- INTERÉS PAGADO -->
                                    <Label Grid.Row="3"
                       Text="{Binding InterestPaid, StringFormat='Int. pagado: $ {0:N0}'}"
                       FontSize="12"
                       TextColor="Gray"/>

                                    <!-- INTERÉS PENDIENTE -->
                                    <Label Grid.Row="3"
                       Grid.Column="1"
                       Text="{Binding PendingInterest, StringFormat='Pendiente: $ {0:N0}'}"
                       FontSize="12"
                       HorizontalOptions="End">

                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                     Binding="{Binding PendingInterest}"
                                     Value="0">
                                                <Setter Property="TextColor" Value="Green"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label"
                                     Binding="{Binding PendingInterest}"
                                     Value="0.0">
                                                <Setter Property="TextColor" Value="Green"/>
                                            </DataTrigger>
                                        </Label.Triggers>

                                    </Label>

                                    <!-- CAPITAL -->
                                    <Label Grid.Row="4"
                       Text="{Binding PrincipalPaid, StringFormat='Capital pagado: $ {0:N0}'}"
                       FontSize="12"
                       TextColor="Gray"/>

                                    <Label Grid.Row="4"
                       Grid.Column="1"
                       Text="{Binding PendingPrincipal, StringFormat='Pendiente: $ {0:N0}'}"
                       FontSize="12"
                       TextColor="Red"
                       HorizontalOptions="End"/>

                                    <BoxView Grid.Row="5"
                                            Grid.ColumnSpan="2"
                                            HeightRequest="1"
                                            BackgroundColor="#E0E0E0"
                                            Margin="0,5"/>

                                    <!-- TOTAL -->
                                    <Label Grid.Row="6"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Balance, StringFormat='Total pendiente: $ {0:N0}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End"/>

                                </Grid>

                                <!--  TRIGGERS VISUALES -->
                                <Frame.Triggers>

                                    <!-- CUANDO ESTÁ PAGADO -->
                                    <DataTrigger TargetType="Frame"
                             Binding="{Binding IsPaid}"
                             Value="True">
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="BackgroundColor" Value="#F5F5F5"/>
                                    </DataTrigger>

                                </Frame.Triggers>

                            </Frame>

                        </SwipeView>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
        </CollectionView>



            <!-- LOADER OVERLAY -->
            <Grid BackgroundColor="#80000000"
          IsVisible="{Binding IsLoading}">

                <ActivityIndicator 
            IsRunning="True"
            Color="White"
            VerticalOptions="Center"
            HorizontalOptions="Center"/>

                <Label Text="Cargando préstamos..."
       TextColor="White"
       HorizontalOptions="Center"
       VerticalOptions="Center"
       Margin="0,40,0,0"/>
            </Grid>

        </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>