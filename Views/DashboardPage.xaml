<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.DashboardPage"
             Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Resumen"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Estado actual de la natillera"
                   Style="{StaticResource SectionSubtitle}" />

            <!-- DISPONIBLE DESTACADO -->
            <Border Style="{StaticResource Card}"
                    BackgroundColor="{StaticResource MetricHighlight}"
                    Stroke="Transparent"
                    Padding="20">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Disponible"
                           TextColor="{StaticResource Secondary}"
                           FontSize="14" />
                    <Label Text="{Binding AvailableMoney, StringFormat='$ {0:N0}'}"
                           TextColor="{StaticResource White}"
                           FontSize="28"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricAportes}" Stroke="Transparent">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Aportes" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TotalContributions, StringFormat='$ {0:N0}'}"
                           Style="{StaticResource MetricValue}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricIntereses}" Stroke="Transparent">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Intereses ganados" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TotalInterest, StringFormat='$ {0:N0}'}"
                           Style="{StaticResource MetricValue}"
                           FontSize="20"
                           TextColor="#7B1FA2" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricPrestamos}" Stroke="Transparent">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Préstamos" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TotalLoaned, StringFormat='Prestado: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding LoanFromContributions, StringFormat='De aportes: $ {0:N0}'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding LoanFromInterest, StringFormat='De intereses: $ {0:N0}'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding LoanFromRaffles, StringFormat='De rifas: $ {0:N0}'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding TotalRecovered, StringFormat='Recuperado: $ {0:N0}'}" Style="{StaticResource SuccessText}" />
                    <Label Text="{Binding TotalOutstandingLoans, StringFormat='Pendiente: $ {0:N0}'}" Style="{StaticResource DangerText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricIntereses}" Stroke="Transparent">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Intereses personales" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TotalInterestPersonal, StringFormat='$ {0:N0}'}"
                           Style="{StaticResource MetricValue}"
                           FontSize="20"
                           TextColor="#7B1FA2" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricPrestamos}" Stroke="Transparent">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Préstamos personales" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TotalLoanedPersonal, StringFormat='Prestado: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding LoanFromInterestPersonal, StringFormat='De intereses: $ {0:N0}'}" Style="{StaticResource Caption}" />
                    <Label Text="{Binding TotalRecoveredPersonal, StringFormat='Recuperado: $ {0:N0}'}" Style="{StaticResource SuccessText}" />
                    <Label Text="{Binding TotalOutstandingLoansPersonal, StringFormat='Pendiente: $ {0:N0}'}" Style="{StaticResource DangerText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricRifas}" Stroke="Transparent">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Rifas" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding TotalRaffles, StringFormat='Total: {0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding TotalRaffleCollected, StringFormat='Recaudado: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding TotalRafflePrizes, StringFormat='Premios: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding RaffleProfit, StringFormat='Ganancia: $ {0:N0}'}" Style="{StaticResource SuccessText}" FontSize="16" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricCaja}" Stroke="Transparent">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Disponible por fuente" Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding AvailableFromContributions, StringFormat='Aportes: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding AvailableFromInterest, StringFormat='Intereses: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding AvailableFromRaffles, StringFormat='Rifas: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding AvailableMoney, StringFormat='Total: $ {0:N0}'}"
                           Style="{StaticResource SuccessText}"
                           FontSize="18" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
