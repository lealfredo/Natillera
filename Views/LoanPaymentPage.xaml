<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.LoanPaymentPage"
             x:Name="Page"
             Title="Pago de préstamo">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="15">

            <!-- INTERESES -->
            <Label Text="Intereses" FontAttributes="Bold" FontSize="16"/>

            <CollectionView ItemsSource="{Binding Months}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame Padding="10"
                               Margin="5"
                               CornerRadius="10"
                               BorderColor="#E0E0E0">

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.ToggleMonthCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <VerticalStackLayout>

                                <Label Text="{Binding Name}"
                                       HorizontalOptions="Center"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding InterestAmount, StringFormat='$ {0:N0}'}"
                                       HorizontalOptions="Center"
                                       FontSize="12"/>

                            </VerticalStackLayout>

                            <Frame.Triggers>

                                <!-- PAGADO -->
                                <DataTrigger TargetType="Frame"
                                             Binding="{Binding IsPaid}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="#BDBDBD"/>
                                </DataTrigger>

                                <!-- SELECCIONADO -->
                                <DataTrigger TargetType="Frame"
                                             Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter Property="BackgroundColor" Value="#4CAF50"/>
                                </DataTrigger>

                            </Frame.Triggers>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Capital pagado"
               TextColor="Green"
               IsVisible="{Binding HasPendingPrincipal, Converter={StaticResource InverseBoolConverter}}"/>

            <!-- CAPITAL -->
            <VerticalStackLayout IsVisible="{Binding HasPendingPrincipal}">

                <Label Text="Capital" FontAttributes="Bold" FontSize="16"/>

                <HorizontalStackLayout>
                    <Label Text="Pago total"/>
                    <Switch IsToggled="{Binding PayFullCapital}"/>
                </HorizontalStackLayout>

                <Entry Placeholder="Monto a abonar"
                       Keyboard="Numeric"
                       Text="{Binding CapitalAmount}"
                       IsEnabled="{Binding PayFullCapital, Converter={StaticResource InverseBoolConverter}}"/>

            </VerticalStackLayout>

            <!-- BOTONES -->
            <HorizontalStackLayout Spacing="10">

                <Button Text="Cancelar"
                        BackgroundColor="#E0E0E0"
                        Command="{Binding CancelCommand}"
                        HorizontalOptions="FillAndExpand"/>

                <Button Text="Confirmar"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        Command="{Binding ConfirmCommand}"
                        HorizontalOptions="FillAndExpand"/>

            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>