<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.LoanPaymentPage"
             x:Name="Page"
             Title="Pago de préstamo">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Registrar pago"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Selecciona meses de interés y abono a capital"
                   Style="{StaticResource SectionSubtitle}" />

            <Border Style="{StaticResource CardMuted}" IsVisible="{Binding IsPersonalLoan}">
                <Label Text="Interés personal"
                       TextColor="{StaticResource Warning}"
                       FontAttributes="Bold" />
            </Border>

            <Border Style="{StaticResource CardMuted}"
                    IsVisible="{Binding IsPersonalLoan, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="Interés natillera"
                       Style="{StaticResource SuccessText}" />
            </Border>

            <CollectionView ItemsSource="{Binding Months}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource Surface}">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.ToggleMonthCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}"
                                       HorizontalOptions="Center"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding InterestAmount, StringFormat='$ {0:N0}'}"
                                       HorizontalOptions="Center"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>

                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsPaid}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Gray200}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Capital pagado"
                   Style="{StaticResource SuccessText}"
                   IsVisible="{Binding HasPendingPrincipal, Converter={StaticResource InverseBoolConverter}}" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasPendingPrincipal}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Capital" Style="{StaticResource FieldLabel}" FontSize="16" />

                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Pago total"
                               Style="{StaticResource BodyLabel}"
                               VerticalOptions="Center" />
                        <Switch IsToggled="{Binding PayFullCapital}" />
                    </HorizontalStackLayout>

                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Monto a abonar"
                           Keyboard="Numeric"
                           Text="{Binding CapitalAmount}"
                           IsEnabled="{Binding PayFullCapital, Converter={StaticResource InverseBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1"
                        Text="Confirmar"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ConfirmCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
