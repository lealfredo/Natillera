<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.SettlementResultPage"
             x:Name="Page"
            Title="Resultados">

    <VerticalStackLayout Padding="15" Spacing="10">

        <!-- BOTÓN -->
        <Button Text="Compartir resultados"
                Command="{Binding ShareCommand}" />

        <!-- CONTENIDO EXPORTABLE -->
        <VerticalStackLayout x:Name="ExportLayout"
                             BackgroundColor="White"
                             Padding="15"
                             Spacing="10">

            <Label Text="Resultados de la Natillera"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <CollectionView ItemsSource="{Binding Results}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Frame CornerRadius="10"
                               Padding="10"
                               Margin="5"
                               BorderColor="#DDD">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"/>
                                    <Label Text="{Binding ContributedFormatted}"
                                           FontSize="12"/>
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding ProfitFormatted}"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="Green"/>

                            </Grid>

                        </Frame>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>