<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.SettlementResultPage"
             x:Name="Page"
             Title="Resultados">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Resultados"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Utilidad por participante"
                   Style="{StaticResource SectionSubtitle}" />

            <Button Text="Compartir resultados"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ShareCommand}" />

            <VerticalStackLayout x:Name="ExportLayout"
                                 BackgroundColor="{StaticResource Surface}"
                                 Padding="4"
                                 Spacing="10">

                <Label Text="Resultados de la Natillera"
                       Style="{StaticResource SectionTitle}"
                       FontSize="18"
                       HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding Results}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource BodyLabel}"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding ContributedFormatted}"
                                               Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="{Binding ProfitFormatted}"
                                           Style="{StaticResource SuccessText}"
                                           VerticalOptions="Center"
                                           FontSize="15" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
