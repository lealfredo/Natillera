<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Natillera.Views"
             x:Class="Natillera.Views.RafflePage"
             Title="{Binding Title}">

    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout x:Name="MainLayout" Style="{StaticResource PageRoot}">

                <Label
                    Text="Rifa semanal"
                    Style="{StaticResource SectionTitle}"
                    HorizontalOptions="Center" />

                <Border Style="{StaticResource Card}"
                        IsVisible="{Binding IsOpen}">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Semana" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding CurrentRaffle.WeekCode}" Style="{StaticResource BodyLabel}" />

                        <Label Text="Fecha del sorteo" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding CurrentRaffle.DrawDate, StringFormat='{0:dd/MM/yyyy}'}"
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="Premio" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding CurrentRaffle.PrizeDescription}" Style="{StaticResource BodyLabel}" />

                        <Label Text="Precio de la boleta" Style="{StaticResource FieldLabel}" />
                        <Label Text="{Binding CurrentRaffle.BetPrize, StringFormat='$ {0:N0}'}"
                               Style="{StaticResource MetricValue}"
                               FontSize="20"
                               TextColor="{StaticResource Primary}" />

                        <Label Text="Premios por acierto"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,8,0,0" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="2 primeras" Style="{StaticResource Caption}" />
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CurrentRaffle.FirstTwoPrize, StringFormat='$ {0:N0}'}"
                                   Style="{StaticResource BodyLabel}"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" Text="2 del medio" Style="{StaticResource Caption}" />
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding CurrentRaffle.MiddleTwoPrize, StringFormat='$ {0:N0}'}"
                                   Style="{StaticResource BodyLabel}"
                                   FontAttributes="Bold" />

                            <Label Grid.Row="2" Grid.Column="0" Text="2 últimas" Style="{StaticResource Caption}" />
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding CurrentRaffle.LastTwoPrize, StringFormat='$ {0:N0}'}"
                                   Style="{StaticResource BodyLabel}"
                                   FontAttributes="Bold" />
                        </Grid>

                        <Button
                            Text="Enviar por WhatsApp"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,8,0,0"
                            Command="{Binding BuildRafflePromotionMessageCommand}" />

                    </VerticalStackLayout>
                </Border>

                <Button
                    Text="{Binding ButtonText}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding GoToCreateRaffleCommand}"
                    CommandParameter="{Binding CurrentRaffle.Id}" />

                <Button
                    Text="Exportar números"
                    Style="{StaticResource PrimaryButton}"
                    IsVisible="{Binding IsOpen}"
                    Command="{Binding ExportNumbersCommand}" />

                <Border Style="{StaticResource CardMuted}"
                        IsVisible="{Binding IsOpen}"
                        Padding="10">
                    <VerticalStackLayout
                        x:Name="ExportLayout"
                        Spacing="8">
                        <Label Text="Números"
                               Style="{StaticResource FieldLabel}" />
                        <ScrollView Orientation="Horizontal">
                            <Grid x:Name="NumbersGrid" />
                        </ScrollView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
