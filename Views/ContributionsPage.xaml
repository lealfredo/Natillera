<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.ContributionsPage"
             x:Name="Page"
             Title="Aportes">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Aportes"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Registra cuotas por participante"
                   Style="{StaticResource SectionSubtitle}" />

            <SearchBar Placeholder="Buscar participante..."
                       Style="{StaticResource SearchField}"
                       Text="{Binding SearchText}" />

            <Border Style="{StaticResource Card}" Padding="0">
                <CollectionView ItemsSource="{Binding FilteredParticipants}"
                                SelectionMode="Single"
                                SelectionChanged="CollectionView_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectParticipantCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding Name}"
                                       Style="{StaticResource BodyLabel}"
                                       FontAttributes="Bold"
                                       FontSize="15" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <Label Text="{Binding SelectedParticipant.Name, StringFormat='Seleccionado: {0}'}"
                   Style="{StaticResource BodyLabel}"
                   TextColor="{StaticResource Primary}"
                   FontAttributes="Italic"
                   IsVisible="{Binding SelectedParticipant, Converter={StaticResource NullToBoolConverter}}" />

            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding IsParticipantSelected}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Monto" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Monto"
                           Keyboard="Numeric"
                           Text="{Binding Amount}" />
                </VerticalStackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding Months}"
                            IsVisible="{Binding IsParticipantSelected}"
                            ItemSizingStrategy="MeasureAllItems">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{StaticResource Surface}">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleMonthCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}"
                                       HorizontalOptions="Center"
                                       FontAttributes="Bold"
                                       FontSize="14">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Text="{Binding PaidAmount, StringFormat='$ {0:N0}'}"
                                       HorizontalOptions="Center"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <ProgressBar Progress="{Binding Progress}" HeightRequest="6" />
                            </VerticalStackLayout>

                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Pending">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Partial">
                                    <Setter Property="BackgroundColor" Value="#FFF3CD" />
                                    <Setter Property="Stroke" Value="{StaticResource Warning}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding State}" Value="Paid">
                                    <Setter Property="BackgroundColor" Value="#C8E6C9" />
                                    <Setter Property="Stroke" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Registrar aporte"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddCommand}" />

            <Label Text="Historial"
                   Style="{StaticResource FieldLabel}"
                   FontSize="16" />

            <CollectionView ItemsSource="{Binding Contributions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Eliminar"
                                               BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding BindingContext.DeleteCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource ListRow}">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="4">

                                    <Label Text="{Binding MonthName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           Grid.ColumnSpan="2" />

                                    <Label Text="{Binding Name}"
                                           Grid.Row="1"
                                           Style="{StaticResource BodyLabel}"
                                           FontAttributes="Bold"
                                           FontSize="13" />

                                    <Label Text="{Binding Amount, StringFormat='$ {0:N0}'}"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           HorizontalOptions="End"
                                           Style="{StaticResource SuccessText}"
                                           FontSize="14" />

                                    <Label Text="{Binding DateFormatted}"
                                           Grid.Row="2"
                                           Style="{StaticResource Caption}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
