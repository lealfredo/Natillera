<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.ParticipantsPage"
             x:Name="Page"
             Title="Participantes">
    <ScrollView>

    <VerticalStackLayout Padding="15" Spacing="10">

        <Entry Placeholder="Teléfono"
               Keyboard="Telephone"
               Text="{Binding Phone}" />

        <!-- Formulario -->
        <Entry Placeholder="Nombre"
               Text="{Binding Name}" />

        <!-- Monto -->
        <Entry Placeholder="Aporte mensual"
               Keyboard="Numeric"
               Text="{Binding MonthlyContribution}" />

        <Button 
            Text="{Binding IsEditing, Converter={StaticResource BoolToTextButtonConverter}}"
            Command="{Binding AddCommand}" />
            <Button 
            Text="Cancelar edición"
            BackgroundColor="Gray"
            TextColor="White"
            IsVisible="{Binding IsEditing}"
            Command="{Binding CancelEditCommand}" />

            <!-- Lista -->
        <CollectionView ItemsSource="{Binding Participants}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>

                            <!-- ACCIONES -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem BackgroundColor="#1976D2"
                                               Command="{Binding BindingContext.ViewStatementCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource Glyph="📊" Color="White"/>
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>

                                    <SwipeItem BackgroundColor="#E53935"
                                               Command="{Binding BindingContext.DeleteCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource Glyph="🗑️" Color="White"/>
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- CARD -->
                            <Frame Padding="12"
               Margin="6"
               CornerRadius="14"
               HasShadow="True"
               BackgroundColor="White"
               BorderColor="#E0E0E0">

                                <Grid ColumnDefinitions="Auto,*,Auto"
                  VerticalOptions="Center">

                                    <!-- ICONO -->
                                    <Frame WidthRequest="40"
                                           HeightRequest="40"
                                           CornerRadius="20"
                                           BackgroundColor="{Binding StatusColor}"
                                           BorderColor="{Binding StatusColor}"
                                           Padding="0"
                                           VerticalOptions="Center">

                                        <Label Text="{Binding Initials}"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold"/>
                                    </Frame>

                                    <!-- INFO -->
                                    <VerticalStackLayout Grid.Column="1"
                                     Margin="10,0"
                                     Spacing="2">

                                        <Label Text="{Binding Name}"
                           FontAttributes="Bold"
                           FontSize="15"/>

                                        <Label Text="{Binding Phone}"
                           FontSize="12"
                           TextColor="Gray"/>

                                        <Label Text="{Binding MonthlyContribution, StringFormat='Aporte: $ {0:N0}'}"
                           FontSize="12"
                           TextColor="#4CAF50"/>

                                    </VerticalStackLayout>

                                    <!-- INDICADOR -->
                                    <BoxView Grid.Column="2"
                         WidthRequest="6"
                         CornerRadius="3"
                         Color="#4CAF50"
                         VerticalOptions="Fill"
                         IsVisible="{Binding IsSelected}"/>

                                </Grid>

                                <!-- TAP -->
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                    Command="{Binding BindingContext.SelectParticipantCommand, Source={x:Reference Page}}"
                    CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <!-- SELECCIÓN -->
                                <Frame.Triggers>
                                    <DataTrigger TargetType="Frame"
                             Binding="{Binding IsSelected}"
                             Value="True">
                                        <Setter Property="BackgroundColor" Value="#E3F2FD"/>
                                        <Setter Property="BorderColor" Value="#1976D2"/>
                                    </DataTrigger>
                                </Frame.Triggers>

                            </Frame>

                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
        </CollectionView>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>