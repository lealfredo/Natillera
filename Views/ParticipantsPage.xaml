<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.ParticipantsPage"
             x:Name="Page"
             Title="Participantes">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Personas"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Agrega o edita participantes"
                   Style="{StaticResource SectionSubtitle}" />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Datos" Style="{StaticResource FieldLabel}" FontSize="16" />

                    <Label Text="Teléfono" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Teléfono"
                           Keyboard="Telephone"
                           Text="{Binding Phone}" />

                    <Label Text="Nombre" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Nombre"
                           Text="{Binding Name}" />

                    <Label Text="Aporte mensual" Style="{StaticResource Caption}" />
                    <Entry Style="{StaticResource FormEntry}"
                           Placeholder="Aporte mensual"
                           Keyboard="Numeric"
                           Text="{Binding MonthlyContribution}" />

                    <Button
                        Text="{Binding IsEditing, Converter={StaticResource BoolToTextButtonConverter}}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCommand}" />

                    <Button
                        Text="Cancelar edición"
                        Style="{StaticResource SecondaryButton}"
                        IsVisible="{Binding IsEditing}"
                        Command="{Binding CancelEditCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Lista"
                   Style="{StaticResource FieldLabel}"
                   FontSize="16" />

            <CollectionView ItemsSource="{Binding Participants}"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Reveal">
                                    <SwipeItem Text="Estado"
                                               BackgroundColor="{StaticResource Info}"
                                               Command="{Binding BindingContext.ViewStatementCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Eliminar"
                                               BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding BindingContext.DeleteCommand, Source={x:Reference Page}}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource ListRow}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.SelectParticipantCommand, Source={x:Reference Page}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                    <Border WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="{Binding StatusColor}"
                                            Padding="0"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Initials}"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource BodyLabel}"
                                               FontAttributes="Bold"
                                               FontSize="15" />
                                        <Label Text="{Binding Phone}"
                                               Style="{StaticResource Caption}" />
                                        <Label Text="{Binding MonthlyContribution, StringFormat='Aporte: $ {0:N0}'}"
                                               Style="{StaticResource SuccessText}"
                                               FontSize="12" />
                                    </VerticalStackLayout>

                                    <BoxView Grid.Column="2"
                                             WidthRequest="6"
                                             CornerRadius="3"
                                             Color="{StaticResource Primary}"
                                             VerticalOptions="Fill"
                                             IsVisible="{Binding IsSelected}" />
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
