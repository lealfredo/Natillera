<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.ParticipantStatementPage"
             Title="Estado de cuenta">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="{Binding Name}"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Movimientos del participante"
                   Style="{StaticResource SectionSubtitle}" />

            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource MetricCaja}" Stroke="Transparent">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Resumen" Style="{StaticResource FieldLabel}" FontSize="16" />
                    <Label Text="{Binding TotalContributions, StringFormat='Aportes: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding TotalLoaned, StringFormat='Préstamos: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding TotalInterestPaid, StringFormat='Intereses pagados: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding TotalRaffleSpent, StringFormat='Boletas compradas: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding TotalRaffleWon, StringFormat='Ganado en rifas: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                    <Label Text="{Binding Balance, StringFormat='Balance: $ {0:N0}'}"
                           Style="{StaticResource SuccessText}"
                           FontSize="18" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Aportes" Style="{StaticResource FieldLabel}" FontSize="16" />
            <CollectionView ItemsSource="{Binding Contributions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding MonthName}" Style="{StaticResource BodyLabel}" />
                                <Label Text="{Binding Amount, StringFormat='$ {0:N0}'}"
                                       Grid.Column="1"
                                       Style="{StaticResource SuccessText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Préstamos natillera" Style="{StaticResource FieldLabel}" FontSize="16" />
            <CollectionView ItemsSource="{Binding NatilleraLoans}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Amount, StringFormat='Monto: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                                <Label Text="{Binding Pending, StringFormat='Pendiente: $ {0:N0}'}" Style="{StaticResource DangerText}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Préstamos personales" Style="{StaticResource FieldLabel}" FontSize="16" />
            <CollectionView ItemsSource="{Binding PersonalLoans}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" Style="{StaticResource Caption}" />
                                <Label Text="{Binding Amount, StringFormat='Monto: $ {0:N0}'}" Style="{StaticResource BodyLabel}" />
                                <Label Text="{Binding Pending, StringFormat='Pendiente: $ {0:N0}'}" Style="{StaticResource DangerText}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Rifas" Style="{StaticResource FieldLabel}" FontSize="16" />
            <CollectionView ItemsSource="{Binding Raffles}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="4">
                                <Label Text="{Binding Description}"
                                       Style="{StaticResource BodyLabel}"
                                       FontAttributes="Bold"
                                       Grid.ColumnSpan="2" />
                                <Label Text="{Binding Amount, StringFormat='Jugado: $ {0:N0}'}"
                                       Grid.Row="1"
                                       Style="{StaticResource Caption}" />
                                <Label Text="{Binding Won, StringFormat='Ganado: $ {0:N0}'}"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       HorizontalOptions="End"
                                       Style="{StaticResource SuccessText}"
                                       FontSize="12"
                                       IsVisible="{Binding Won, Converter={StaticResource GreaterThanZeroConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
