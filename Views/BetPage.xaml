<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Natillera.Views.BetPage"
             xmlns:viewModels="clr-namespace:Natillera.ViewModels"
             x:DataType="viewModels:BetViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageRoot}">

            <Label Text="Registrar apuesta"
                   Style="{StaticResource SectionTitle}" />
            <Label Text="Asigna el número a un participante"
                   Style="{StaticResource SectionSubtitle}" />

            <Border Style="{StaticResource HeroNumber}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Número"
                           TextColor="{StaticResource Secondary}"
                           FontSize="12"
                           HorizontalOptions="Center" />
                    <Label
                        Text="{Binding SelectedNumber}"
                        FontSize="32"
                        HorizontalOptions="Center"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Teléfono" Style="{StaticResource Caption}" />
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="Teléfono"
                        Keyboard="Telephone"
                        Text="{Binding ParticipantPhone}"
                        Unfocused="OnPhoneUnfocused" />

                    <Label Text="Nombre" Style="{StaticResource Caption}" />
                    <Entry
                        Style="{StaticResource FormEntry}"
                        Placeholder="Nombre del participante"
                        Text="{Binding ParticipantName}"
                        IsEnabled="{Binding IsNewParticipant}" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Guardar apuesta"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding SaveBetCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
